<section>
  <p class="scene-title">{{sceneName}}</p>
  {{#unless isController}}<p class="notes">The controlling GM operates this scene. Settings remain available for inspection.</p>{{/unless}}
  {{#if failed}}<p class="error">Engine stopped: {{lastError}}</p><button type="button" data-action="resume">Resume engine</button>{{/if}}
  {{#if gamePaused}}<p class="notes"><strong>Foundry is paused.</strong> Rotation will begin when you press Space to unpause the game.</p>{{/if}}
  {{#each slots}}
  <div class="rotation-slot">
    <div class="slot-heading"><strong>{{label}}</strong><span class="image-name" title="{{imageName}}">{{#if tileId}}{{tileId}}{{else}}No tile selected{{/if}}</span><span>{{status}}</span></div>
    <button type="button" data-action="target" data-slot="{{id}}" {{#unless ../isController}}disabled{{/unless}}><i class="fas fa-crosshairs"></i> Target tile</button>
    <div class="slot-speed"><span>Speed{{#if speedLevel}} {{speedLevel}}/8{{/if}} · {{speed}}°/s</span><button type="button" data-action="speedDown" data-slot="{{id}}" aria-label="Decrease slot {{label}} speed" title="Select the previous speed level" {{#unless canSlow}}disabled{{/unless}} {{#unless assigned}}disabled{{/unless}} {{#unless ../isController}}disabled{{/unless}}>−</button><button type="button" data-action="speedUp" data-slot="{{id}}" aria-label="Increase slot {{label}} speed" title="Select the next speed level" {{#unless canSpeed}}disabled{{/unless}} {{#unless assigned}}disabled{{/unless}} {{#unless ../isController}}disabled{{/unless}}>+</button></div>
    <div class="slot-direction">{{directionText}}</div>
    <div class="actions"><button type="button" data-action="{{toggle}}" data-slot="{{id}}" {{#unless assigned}}disabled{{/unless}} {{#unless ../isController}}disabled{{/unless}}>{{toggleText}}</button><button type="button" data-action="reverse" data-slot="{{id}}" {{#unless assigned}}disabled{{/unless}} {{#unless ../isController}}disabled{{/unless}}>Reverse</button><button type="button" data-action="reset" data-slot="{{id}}" {{#unless assigned}}disabled{{/unless}} {{#unless ../isController}}disabled{{/unless}}>Reset rotation</button></div>
    <button type="button" data-action="setDefault" data-slot="{{id}}" title="Save this tile’s current angle as its reset position" {{#unless assigned}}disabled{{/unless}} {{#unless ../isController}}disabled{{/unless}}>Set as default rotation</button>
  </div>
  {{/each}}
  <div class="actions"><button type="button" data-action="pauseAll" {{#unless isController}}disabled{{/unless}}>Pause all</button><button type="button" data-action="settings"><i class="fas fa-cog"></i> Settings</button><button type="button" data-action="help">Help</button></div>
</section>
