<form autocomplete="off" class="rd-form">
{{#if noScene}}<p>Open a scene, then reopen this panel.</p>{{else}}
  <header class="rd-intro"><strong>{{sceneName}}</strong><button type="button" data-action="help">Help</button><p>Target a tile, choose its mask, then save. Walls are created automatically.</p></header>
  {{#unless enabled}}<p class="error">Enable “This scene has Rotating Elements” in Scene Configuration to rotate.</p>{{/unless}}
  {{#if failed}}<p class="error">Engine stopped after an error.</p><button type="button" data-action="resume">Resume engine</button>{{/if}}
  {{#each slots}}
  <fieldset class="rd-slot"><legend>Slot {{label}}</legend>
    <div class="rd-target-row"><code data-tile-id="{{id}}">{{#if tileId}}{{tileId}}{{else}}Not selected{{/if}}</code><button type="button" data-action="target" data-slot="{{id}}"><i class="fas fa-crosshairs"></i> Target tile</button></div>
    <label class="rd-field">Or choose a scene tile<select name="{{id}}.tileId" data-slot-select="{{id}}"><option value="">None</option>{{#each tiles}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label class="rd-field">Wall mask image</label><div class="rd-mask-row"><input aria-label="Slot {{label}} wall mask image" type="text" name="{{id}}.maskPath" value="{{maskPath}}" placeholder="Optional black-and-white mask"><button type="button" data-action="browse" data-slot="{{id}}"><i class="fas fa-folder-open"></i> Browse / Upload</button></div>
    <p class="notes" data-mask-status="{{id}}">{{#if maskPath}}Walls update automatically when you save.{{else}}Auto-finds _mask / _Mask beside the artwork. PNG or the artwork’s image format.{{/if}}</p>
    <div class="rd-two"><label class="rd-field">Speed (°/sec)<input type="number" name="{{id}}.speed" value="{{speed}}" min="0.01" max="10" step="0.01"></label><label class="rd-field">Direction<select name="{{id}}.direction"><option value="1" {{#if clockwise}}selected{{/if}}>Clockwise</option><option value="-1" {{#unless clockwise}}selected{{/unless}}>Counterclockwise</option></select></label></div>
    <p class="rd-status">{{walls}} walls · {{notes}} journal pins · {{lights}} lights detected</p>
    <details><summary>Advanced settings</summary>
      <div class="rd-checks"><label><input type="checkbox" name="{{id}}.vision" {{checked vision}}>Mask blocks vision & light</label><label><input type="checkbox" name="{{id}}.collision" {{checked collision}}>Mask blocks movement</label><label><input type="checkbox" name="{{id}}.carry" {{checked carry}}>Carry tokens</label><label><input type="checkbox" name="{{id}}.carryNotes" {{checked carryNotes}}>Carry scene journal pins</label><label><input type="checkbox" name="{{id}}.carryLights" {{checked carryLights}}>Carry scene lights</label></div>
      <label class="rd-field">Floor region<select name="{{id}}.footprint">{{#each footprints}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="rd-field">Bands (only for radial regions)<input name="{{id}}.bands" value="{{bands}}" placeholder="0-0.25,0.6-1"></label>
      <div class="rd-two"><label class="rd-field">Mask resolution<select name="{{id}}.resolution">{{#each resolutions}}<option value="{{n}}" {{#if selected}}selected{{/if}}>{{n}} pixels</option>{{/each}}</select></label><label class="rd-field">Black threshold<input type="number" name="{{id}}.threshold" value="{{threshold}}" min="1" max="254" step="1"></label></div>
    </details>
  </fieldset>
  {{/each}}
  <p class="notes">Journal pins and lights already on each floor follow it automatically. Use the floating controls to start or pause rotation.</p>
  <details><summary>Performance</summary><label class="rd-field">Geometry updates per second<input type="number" name="hz" value="{{hz}}" min="1" max="10" step="1"></label><label><input type="checkbox" name="smooth" {{checked smooth}}>Smooth tile artwork</label></details>
  <footer class="rd-save"><button type="submit"><i class="fas fa-save"></i> Save & apply masks</button></footer>
{{/if}}
</form>
