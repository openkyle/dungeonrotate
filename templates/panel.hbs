<form autocomplete="off">
{{#if noScene}}<p>Open a scene, then reopen this panel.</p>{{else}}
  <p><strong>{{sceneName}}</strong> · Controlling GM: {{authority}}</p>
  {{#unless enabled}}<p class="error">Rotation is disabled. Enable “This scene has Rotating Elements” in Scene Configuration.</p>{{/unless}}
  <p class="notes">Choose existing scene tiles. Image paths and tile IDs are never built into the module. Save settings before generating walls or starting rotation.</p>
  {{#if failed}}<p class="error">Engine stopped after an error. Fix the reported issue before resuming.</p><button type="button" data-action="resume">Resume engine</button>{{/if}}
  {{#each slots}}
  <fieldset>
    <legend>Slot {{label}} · {{#if running}}Running{{else}}Paused{{/if}} · {{walls}} walls</legend>
    <div class="form-group"><label>Scene tile</label><div class="form-fields"><select name="{{id}}.tileId"><option value="">None</option>{{#each tiles}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><button type="button" data-action="selected" data-slot="{{id}}" title="Use the selected tile"><i class="fas fa-crosshairs"></i></button></div></div>
    <div class="form-group"><label>Wall mask PNG</label><div class="form-fields"><input type="text" name="{{id}}.maskPath" value="{{maskPath}}" placeholder="Select or upload a black-and-white PNG"><button type="button" class="file-picker" data-type="image" data-target="{{id}}.maskPath" title="Browse mask images"><i class="fas fa-file-import"></i></button></div></div>
    <div class="form-group"><label>Speed (degrees/sec)</label><div class="form-fields"><input type="number" name="{{id}}.speed" value="{{speed}}" min="0.01" max="10" step="0.01"><select name="{{id}}.direction"><option value="1" {{#if clockwise}}selected{{/if}}>Clockwise</option><option value="-1" {{#unless clockwise}}selected{{/unless}}>Counterclockwise</option></select></div></div>
    <div class="form-group"><label>Mask resolution / threshold</label><div class="form-fields"><select name="{{id}}.resolution">{{#each resolutions}}<option value="{{n}}" {{#if selected}}selected{{/if}}>{{n}} pixels</option>{{/each}}</select><input aria-label="Black threshold" type="number" name="{{id}}.threshold" value="{{threshold}}" min="1" max="254" step="1"></div></div>
    <div class="checks"><label><input type="checkbox" name="{{id}}.vision" {{checked vision}}>Block vision & light</label><label><input type="checkbox" name="{{id}}.collision" {{checked collision}}>Block movement</label><label><input type="checkbox" name="{{id}}.carry" {{checked carry}}>Carry tokens</label><label><input type="checkbox" name="{{id}}.carryNotes" {{checked carryNotes}}>Carry journal pins</label><label><input type="checkbox" name="{{id}}.carryLights" {{checked carryLights}}>Carry scene lights</label></div>
    <div class="form-group"><label>Automatic floor region</label><div class="form-fields"><select name="{{id}}.footprint"><option value="rectangle" {{#unless radial}}selected{{/unless}}>Whole rectangle</option><option value="radial" {{#if radial}}selected{{/if}}>Radial bands (rings)</option></select><input aria-label="Radial bands" name="{{id}}.bands" value="{{bands}}" placeholder="0-0.25,0.6-1"></div></div>
    <p class="notes">Radial values run from center (0) to tile edge (1). Comma-separated bands support disconnected inner and outer rings on one tile. Masks align to the unrotated tile image; current tile rotation is applied automatically.</p>
    <div class="actions"><button type="button" data-action="generate" data-slot="{{id}}">Generate walls</button><button type="button" data-action="remove" data-slot="{{id}}">Remove walls</button><button type="button" data-action="start" data-slot="{{id}}">Start</button><button type="button" data-action="pause" data-slot="{{id}}">Pause</button><button type="button" data-action="reverse" data-slot="{{id}}">Reverse</button></div>
  </fieldset>
  {{/each}}
  <div class="form-group"><label>Wall/token updates per second</label><input type="number" name="hz" value="{{hz}}" min="1" max="10" step="1"></div>
  <label><input type="checkbox" name="smooth" {{checked smooth}}>Smooth tile artwork between geometry updates</label>
  <p class="notes">Start at 0.5°/sec and 5 updates/sec. Walls and tokens update in steps; smooth artwork can lead them slightly. Disable smooth artwork for closer visual alignment. Fog exploration is world-space: disable it in Scene settings for this encounter.</p>
  <fieldset><legend>Selected tokens: floor attachment</legend><div class="actions"><button type="button" data-action="auto">Automatic</button><button type="button" data-action="a">Slot A</button><button type="button" data-action="b">Slot B</button><button type="button" data-action="none">Do not carry</button></div><p class="notes">Explicit attachment stays assigned even outside a floor region. Automatic attachment follows radial bands; B wins new overlaps. Existing riders stay attached until leaving their region.</p></fieldset>
  <fieldset><legend>Journal pin attachment</legend><div class="form-group"><select name="noteId">{{#each notes}}<option value="{{id}}">{{label}}</option>{{/each}}</select></div><div class="form-group"><select name="noteAttachment"><option value="auto">Automatic floor region</option><option value="a">Slot A</option><option value="b">Slot B</option><option value="none">Do not carry</option></select><button type="button" data-action="noteAttach">Apply to pin</button></div><p class="notes">Pins keep their journal/page links. Explicit assignment handles pins inside walls or overlapping floor regions.</p></fieldset>
  <fieldset><legend>Scene light attachment</legend><div class="form-group"><select name="lightId">{{#each lights}}<option value="{{id}}">{{label}}</option>{{/each}}</select></div><div class="form-group"><select name="lightAttachment"><option value="auto">Automatic floor region</option><option value="a">Slot A</option><option value="b">Slot B</option><option value="none">Do not carry</option></select><button type="button" data-action="lightAttach">Apply to light</button></div><p class="notes">Position and directional-cone orientation follow the floor. Color, intensity, animation, and other light settings are preserved.</p></fieldset>
  <footer><button type="submit"><i class="fas fa-save"></i>Save configuration (both slots must be paused)</button></footer>
{{/if}}
</form>
